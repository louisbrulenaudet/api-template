{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.env",
  "python.languageServer": "None",
  "ty.disableLanguageServices": false,
  "ty.importStrategy": "fromEnvironment",
  "ty.diagnosticMode": "workspace",
  "ty.inlayHints.variableTypes": true,
  "ty.inlayHints.callArgumentNames": true,
  "ty.completions.autoImport": true,
  "ty.completions.completeFunctionParentheses": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.nativeServer": "on",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "--no-cov", "--maxfail=0"],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  },
  "[yaml]": { "editor.formatOnSave": false },
  "[json]": { "editor.formatOnSave": false },
  "[jsonc]": { "editor.formatOnSave": false },
  "[toml]": { "editor.formatOnSave": false },
  "[dockerfile]": { "editor.formatOnSave": false },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".ruff_cache": true,
    ".pytest_cache": true,
    ".mypy_cache": true,
    "htmlcov": true,
    ".coverage": true,
    "**/.DS_Store": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/htmlcov/**": true,
    "**/.git/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".ruff_cache": true,
    ".pytest_cache": true,
    ".mypy_cache": true,
    "htmlcov": true,
    ".coverage": true,
    "uv.lock": true,
    "requirements.txt": true
  },
  "search.useIgnoreFiles": true,
  "search.followSymlinks": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "git.autofetch": true,
  "git.branchProtection": ["main", "master"],
  "cSpell.enabled": true,
  "cSpell.language": "en",
  "cSpell.ignorePaths": [
    "**/.vscode/**",
    "uv.lock",
    "**/*.lock",
    ".git/**",
    "**/__pycache__/**",
    "htmlcov/**"
  ],
