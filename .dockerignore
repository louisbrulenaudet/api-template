# Allowlist: exclude everything, then re-include only what the Dockerfile COPYs, so a new `COPY <path>`
# needs a matching `!<path>` here. The blanket guarantee stops at `!app/**` - hence the re-exclusions
# below, which are the real protection (ops/dockerfile).
*

# builder stage - uv sync --frozen --no-dev
!pyproject.toml
!uv.lock

# runtime stage - application source
!app/
!app/**

# …but never ship host bytecode caches that slipped into the allowlisted app/ tree.
app/**/__pycache__
app/**/*.pyc

app/**/.DS_Store
app/**/._*
app/**/.AppleDouble
app/**/.Spotlight-V100

# dotenv, in every naming convention
app/**/.env
app/**/.env.*
app/**/*.env

# keys, certificates and keystores
app/**/*.pem
app/**/*.key
app/**/*.crt
app/**/*.p8
app/**/*.p12
app/**/*.pfx
app/**/*.jks
app/**/*.keystore
app/**/id_rsa*
app/**/id_ed25519*
app/**/id_ecdsa*

# tool credential files that carry bearer tokens
app/**/.netrc
app/**/.npmrc
app/**/.pypirc
app/**/*credentials*.json
app/**/*service-account*.json

# any directory an operator would plausibly call a secret store
app/**/secrets/**
app/**/.secrets/**
