{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make check)",
      "Bash(make format)",
      "Bash(make test)",
      "Bash(make type-check)",
      "Bash(make ci)",
      "Bash(make sync)",
      "Bash(make lock)",
      "Bash(make update)",
      "Bash(make pre-commit)",
      "Bash(make help)",
      "Bash(make docker-check)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.uvicorn.org)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:www.starlette.io)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials.json)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.mypy_cache/**)",
      "Read(**/htmlcov/**)",
      "Read(**/.coverage)",
      "Read(**/.coverage.*)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/hooks/logs/**)",
      "Read(**/node_modules/**)",
      "Read(**/.git/**)",
      "Read(**/.claude/settings.local.json)",
      "Edit(**/.venv/**)",
      "Edit(**/__pycache__/**)",
      "Edit(**/.ruff_cache/**)",
      "Edit(**/.pytest_cache/**)",
      "Edit(**/htmlcov/**)",
      "Edit(**/.coverage)",
      "Edit(**/.coverage.*)",
      "Edit(**/node_modules/**)",
      "Edit(**/.git/**)",
      "Edit(**/uv.lock)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-secret-commit.sh"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-destructive-git.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/quality/check-changed.sh"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/logging/instructions-loaded.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "python-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ]
    }
  },
  "worktree": {
    "sparsePaths": [
      ".claude",
      "app",
      "tests",
      "hooks",
      "make"
    ],
    "symlinkDirectories": [".venv"]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/status-line.sh\""
  },
  "preferredNotifChannel": "terminal_bell",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 20,
  "includeGitInstructions": false,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "enableAllProjectMcpServers": false
}
